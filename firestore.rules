rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the single shared team account may use the app.
    // If you used a different email in Firebase, change it here (lowercase).
    function isTeam() {
      return request.auth != null
          && request.auth.token.email == 'almsassgroup@gmail.com';
    }

    match /rooms/{roomId} {
      allow read: if isTeam();
      allow create, update: if isTeam()
          && request.resource.data.status in ['free', 'cleaning', 'busy', 'unavailable'];
      allow delete: if false;
    }
  }
}
